<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:TextField label="" placeholder-text="Konuş..." name="InputDialogue" style="font-size: 30px; -unity-text-align: middle-left; text-overflow: clip; align-self: auto; align-content: auto; align-items: flex-start; bottom: 64px; left: 40px; position: relative; justify-content: flex-start; -unity-text-auto-size: none; width: 562px; top: 88%;"/>
    <ui:Label text="ENTER ile gönder, ESC ile konuşmadan ayrıl" name="Hints" style="left: 52px; bottom: auto; right: auto; top: 88%; -unity-text-align: upper-left; font-size: 26px; color: rgb(255, 255, 255); -unity-text-outline-width: -304px; text-shadow: 3px 2px 0 rgba(0, 0, 0, 0.639); position: relative;"/>
    <ui:Label text="-- Diyalog başlangıcı --" name="MessageLog" style="font-size: 30px; background-color: rgba(0, 0, 0, 0.239); bottom: 0%; left: 40px; color: rgb(255, 255, 255); right: auto; -unity-text-align: lower-left; max-width: 75%; min-height: 76%; padding-left: 17px; padding-bottom: 16px; min-width: 75px; height: 76px; max-height: 76px; white-space: normal;"/>
</ui:UXML>
